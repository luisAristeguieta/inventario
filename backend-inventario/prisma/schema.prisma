generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id         Int      @id @default(autoincrement())
  nombre     String
  precio     Float
  categoria  String
  fotoBase64 String?  @db.Text
  createdAt  DateTime @default(now())
}